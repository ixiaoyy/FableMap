FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip libfontconfig1 libx11-6 libxcursor1 libxinerama1 libgl1 libxi6 libxrandr2 && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/apps/mirror-island

COPY apps/mirror-island/godot/engine-lock.json ./godot/engine-lock.json
COPY apps/mirror-island/scripts/godot.mjs ./scripts/godot.mjs
RUN node scripts/godot.mjs setup

COPY apps/mirror-island/package.json apps/mirror-island/package-lock.json ./
RUN npm ci --ignore-scripts --legacy-peer-deps

COPY apps/mirror-island/ ./
COPY deploy/cdn/game-media-manifest.json /workspace/deploy/cdn/game-media-manifest.json

RUN npm run build:client && npm run typecheck:client

FROM nginx:1.27-alpine AS runtime

COPY apps/mirror-island/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/apps/mirror-island/godot/exports/web /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
