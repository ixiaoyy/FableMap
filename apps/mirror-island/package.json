{
  "name": "mirror-island",
  "version": "1.0.0",
  "main": "dist/runtime/index.js",
  "scripts": {
    "prepare:media": "node scripts/prepare-media.mjs",
    "generate:foundation-maps": "node scripts/generate-foundation-maps.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "identity:up": "docker compose -f docker-compose.identity.yml up -d keycloak",
    "identity:configure": "cross-env MIRROR_ISLAND_FORUM_OIDC_CLIENT_SECRET=development-forum-oidc-client-secret MIRROR_ISLAND_FORUM_ENTRY_CLIENT_SECRET=development-forum-entry-client-secret node scripts/configure-keycloak-profile.mjs",
    "identity:down": "docker compose -f docker-compose.identity.yml down",
    "dev:services:up": "docker compose -f docker-compose.identity.yml up -d keycloak mirror-game-db",
    "dev:services:down": "docker compose -f docker-compose.identity.yml down",
    "predev": "npm run prepare:media",
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "predev:client": "npm run prepare:media",
    "dev:client": "vite --config vite.config.ts --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:client",
    "build:client": "vite build --config vite.config.ts",
    "build:server": "vite build --config vite.server.config.ts",
    "pretypecheck": "npm run prisma:generate",
    "typecheck": "vue-tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json",
    "test:identity": "node --experimental-strip-types --test test/sso-contract.test.mjs test/retirement-contract.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "Single-player Phaser and Vue farming world for Mirror Island",
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/oidc-provider": "9.11.1",
    "@types/pg": "8.23.1",
    "@vitejs/plugin-vue": "6.0.8",
    "cross-env": "10.1.0",
    "prisma": "7.9.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vue-tsc": "3.3.10"
  },
  "private": true,
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "express": "5.2.1",
    "jose": "6.2.9",
    "keycloak-js": "26.2.4",
    "oidc-provider": "9.11.1",
    "pg": "8.23.0",
    "phaser": "4.2.1",
    "vue": "3.5.41"
  },
  "overrides": {
    "brace-expansion": "2.1.4",
    "esbuild": "0.28.2",
    "nanoid": "3.3.18"
  },
  "type": "module"
}
